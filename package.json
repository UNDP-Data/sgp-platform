{
  "name": "sgp-platform",
  "version": "0.1.0",
  "description": "GEF Small Grants Programme Knowledge and Learning Platform",
  "private": true,
  "type": "module",
  "homepage": "https://undp-data.github.io/sgp-platform/",
  "repository": {
    "type": "git",
    "url": "https://github.com/UNDP-Data/sgp-platform.git"
  },
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "sync:data": "node scripts/sync-data.mjs",
    "sync:routes": "node scripts/generate-runtime-sitemap.mjs",
    "optimize:stories": "node scripts/cache-story-images.mjs",
    "validate:data": "node scripts/validate-data.mjs",
    "lint": "node scripts/lint.mjs",
    "audit:i18n": "node scripts/audit-interface-translations.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "typecheck": "tsc -b",
    "test": "vitest run --exclude 'tests/e2e/**'",
    "test:e2e": "playwright test",
    "verify": "npm run lint && npm run audit:i18n && npm run docs:check && npm run typecheck && npm test && npm run validate:data",
    "check": "npm run verify && npm run build",
    "build": "npm run sync:routes && npm run validate:data && tsc -b && vite build && node scripts/postbuild.mjs",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.13.12",
    "d3": "^7.9.0",
    "d3-dsv": "^3.0.1",
    "file-saver": "^2.0.5",
    "fuse.js": "^7.1.0",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.49.1",
    "@types/d3": "^7.4.3",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
