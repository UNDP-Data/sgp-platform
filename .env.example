# Temporary local backend. Keep host loopback-only unless the security model is replaced.
SGP_BACKEND_HOST=127.0.0.1
SGP_BACKEND_PORT=8787
SGP_BACKEND_DATA_DIR=.local/backend
SGP_BACKEND_DB=.local/backend/sgp-platform.sqlite3
SGP_BACKEND_FILES=.local/backend/evidence
SGP_BACKEND_MAX_FILE_BYTES=8388608
SGP_BACKEND_SESSION_HOURS=12

# Development partner API keys. Set non-default values for shared test machines.
SGP_PUBLIC_API_KEY=sgp-public-dev
SGP_AGENCY_API_KEY=sgp-agency-dev
SGP_CONTROLLED_API_KEY=sgp-controlled-dev

# Vite development proxy and browser adapters.
SGP_BACKEND_URL=http://127.0.0.1:8787
VITE_SGP_BACKEND_ENABLED=true
VITE_SGP_BACKEND_URL=/api
VITE_SGP_AI_API_BASE=/api/sgp-ai
VITE_SGP_PARTNER_API_BASE=/api/v1
